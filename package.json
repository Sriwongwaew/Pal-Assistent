{
  "name": "palassistent",
  "version": "2.2.1",
  "private": true,
  "description": "Palworld assistant built from Level.sav - box, breeding planner and recommendations",
  "author": "Kensiwat Sriwongwaew",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/ensure-data.mjs",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/ensure-data.mjs",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "passive-text": "node scripts/passive-text.mjs",
    "docs-images": "node scripts/docs-images.mjs",
    "docs-shots": "node scripts/docs-shots.mjs",
    "preversion": "node scripts/changelog.mjs check",
    "version": "node scripts/changelog.mjs stamp && git add CHANGELOG.md",
    "prepackage": "node scripts/ensure-data.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build.ps1",
    "test": "tsc -p tsconfig.test.json && node --test \"tests-dist/tests/*.test.js\""
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.4.5",
    "typescript": "^5.8.0"
  }
}
